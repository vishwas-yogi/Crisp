{
  "name": "crisp",
  "version": "0.1.0",
  "description": "Local AI writing assistant — rewrites selected text globally across macOS apps",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "build": "tsc",
    "rewrite": "tsx src/cli.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "install-service": "bash scripts/install-service.sh",
    "build:hotkey": "swiftc helper/hotkey.swift -o helper/hotkey-bin"
  },
  "dependencies": {
    "clipboardy": "^4.0.0",
    "ollama": "^0.5.0",
    "smol-toml": "^1.3.0",
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.62.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
